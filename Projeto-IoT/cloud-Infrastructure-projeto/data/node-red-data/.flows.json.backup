    {
        "id": "fa369d25ae7516fb",
        "type": "function",
        "z": "83207b460763f17a",
        "name": "function 14",
        "func": "const year = flow.get(\"selected_year\");\nconst month = flow.get(\"selected_month\");\nconst day = flow.get(\"selected_day\"); // vamos setar isto no onDaySelected\n\nif (!year) {\n    node.error(\"Selecciona um ano antes de carregar as estatísticas\");\n    return null;\n}\n\nlet url = null;\nif (year && !month) {\n    // somente ano\n    url = `http://app:8000/stats/year/${year}`;\n} else if (year && month && !day) {\n    // ano + mês\n    url = `http://app:8000/stats/month/${year}/${month}`;\n} else if (year && month && day) {\n    // ano + mês + dia\n    url = `http://app:8000/stats/day/${year}/${month}/${day}`;\n} else {\n    // caso improvável — default para ano\n    url = `http://app:8000/stats/year/${year}`;\n}\n\nmsg.method = \"GET\";\nmsg.url = url;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 200,
        "wires": [
            [
                "32ec0eeba8db56bd"
            ]
        ]
    },
