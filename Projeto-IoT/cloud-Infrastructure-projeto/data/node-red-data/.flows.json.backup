        "func": "// limpar memória\nflow.set(\"selected_year\", null);\nflow.set(\"selected_month\", null);\nflow.set(\"selected_day\", null);\n\n// 1) limpar dropdown YEAR\nnode.send({\n    _dropdown: \"year\",\n    options: [],\n    payload: \"\"\n});\n\n// 2) limpar dropdown MONTH\nnode.send({\n    _dropdown: \"month\",\n    options: [],\n    payload: \"\"\n});\n\n// 3) limpar dropdown DAY\nnode.send({\n    _dropdown: \"day\",\n    options: [],\n    payload: \"\"\n});\n\n// 4) limpar tabela\nnode.send({\n    _dropdown: \"table\",\n    payload: []\n});\n\n// 5) pedir nova lista de anos\nreturn { reset: true };",
