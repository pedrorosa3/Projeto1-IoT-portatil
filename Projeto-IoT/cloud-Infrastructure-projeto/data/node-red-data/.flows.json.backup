        "func": "const month = msg.payload;\nflow.set(\"selected_month\", month);\n\nconst year = flow.get(\"selected_year\");\nmsg.method = \"GET\";\nmsg.url = `http://app:8000/available-days/${year}/${month}`;\nreturn msg;",
