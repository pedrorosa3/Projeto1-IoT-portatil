        "name": "function 9",
        "func": "// espera payload: { \"years\": [2023, 2024, ...] }\nconst years = (msg.payload && msg.payload.years) ? msg.payload.years : [];\nmsg.options = years;\nmsg.ui_control = msg.ui_control || {};\nmsg.ui_control.options = years.map(y => ({ label: String(y), value: y }));\nreturn msg;",
